<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ch.architectdna.arclink</string>

  <!-- EDIT the two paths: replace USERNAME with your Mac short name (echo $USER).
       If `which python3` prints something else, use that path instead of /usr/bin/python3. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/USERNAME/arc-link/arclink.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <!-- Optional: force the tablet size if a tap lands off.
    <key>ARCLINK_SIZE</key><string>2560x1600</string> -->
  </dict>

  <key>RunAtLoad</key><true/>
  <!-- Restart after a crash, but not after F9 (a clean exit) — so F9 really quits. -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>/tmp/arclink.out.log</string>
  <key>StandardErrorPath</key><string>/tmp/arclink.err.log</string>
</dict>
</plist>
